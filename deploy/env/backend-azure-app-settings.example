# Zestia backend - Azure App Service > Settings > Environment variables
# DAY LA FILE MAU. Khong dien bi mat that vao file nay va khong doi ten thanh .env de commit.
# Khong co dau cach quanh dau "=". URL origin khong co dau "/" o cuoi.

# Bat buoc
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:sqlserver://<sql-server-name>.database.windows.net:1433;databaseName=<database-name>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;
DB_USERNAME=zestia_app
DB_PASSWORD=<set-only-in-azure-portal>
JWT_SECRET=<random-secret-at-least-64-bytes>

# Dia chi cong khai
APP_BACKEND_URL=https://<azure-app-name>.azurewebsites.net
APP_FRONTEND_URL=https://www.<your-domain>
APP_PAYMENT_RESULT_URL=https://www.<your-domain>/payment-result
APP_CORS_ALLOWED_ORIGINS=https://<netlify-site-name>.netlify.app,https://<your-domain>,https://www.<your-domain>

# Luu anh ben ngoai App Service (bat buoc khi deploy)
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<set-only-in-azure-portal>
CLOUDINARY_API_SECRET=<set-only-in-azure-portal>

# Gioi han tai nguyen cho App Service F1
SERVER_PORT=80
JAVA_OPTS=-Xms128m -Xmx512m -Duser.timezone=Asia/Ho_Chi_Minh -Dfile.encoding=UTF-8
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
PASSWORD_RESET_TOKEN_MINUTES=30

# Tai khoan quan tri khoi tao (backend da ho tro one-time bootstrap).
# Dat password tam thoi manh, dang nhap va doi ngay, sau do xoa DEPLOYMENT_ADMIN_PASSWORD khoi Azure.
DEPLOYMENT_ADMIN_USERNAME=admin
DEPLOYMENT_ADMIN_PASSWORD=<temporary-strong-password>

# Google Sign-In: Client ID la dinh danh cong khai, khong phai Client Secret.
GOOGLE_CLIENT_ID=<google-oauth-web-client-id>.apps.googleusercontent.com

# Gmail: tuy chon. App Password van la BI MAT va chi dat tai Azure.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

# OpenAI: de trong/khong tao app setting nay de giu chi phi 0 dong.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=30

# Thanh toan sandbox: tuy chon. Tat refund tu xa neu chua cau hinh day du.
PAYMENT_REFUND_REMOTE_ENABLED=false
MOMO_PARTNER_CODE=<optional-sandbox-value>
MOMO_ACCESS_KEY=<optional-set-only-in-azure>
MOMO_SECRET_KEY=<optional-set-only-in-azure>
PAYMENT_MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
ZALOPAY_APP_ID=<optional-sandbox-value>
ZALOPAY_KEY1=<optional-set-only-in-azure>
ZALOPAY_KEY2=<optional-set-only-in-azure>
PAYMENT_ZALOPAY_ENABLED=false
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_REFUND_ENDPOINT=https://sb-openapi.zalopay.vn/v2/refund
ZALOPAY_QUERY_REFUND_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query_refund

# Khong tao bien PORT thu cong. Cau hinh ban deploy nay dung SERVER_PORT=80.
